{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "planegy",
  "main": "src/worker.js",
  "compatibility_date": "2026-09-13",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,

  // Die Seiten liegen im Repo-Root. Was nicht öffentlich sein darf,
  // steht in .assetsignore.
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    // /blog liefert blog.html, /blog.html leitet auf /blog um (wie pretty_urls bei Netlify)
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "none",
    // /blog/* : 301 von /blog/<slug> auf /blog-<slug> (BabyLoveGrowth erwartet dieses Muster)
    "run_worker_first": ["/.netlify/functions/*", "/api/*", "/danke", "/blog", "/blog/*"]
  },

  // Secrets (nicht hier eintragen): GITHUB_TOKEN, BLG_WEBHOOK_SECRET, BREVO_API_KEY
  "vars": {
    "GITHUB_REPO": "adonas-png/planegy",
    "GITHUB_BRANCH": "main",
    "FORM_TO": "kontakt@planegy.de",
    "FORM_FROM": "formular@planegy.de"
  },

  // www.planegy.de → planegy.de: nicht im Worker, sondern als Redirect Rule im
  // Cloudflare-Dashboard (Rules → Redirect Rules → Single Redirects), damit der
  // Worker nicht für jede Anfrage laufen muss:
  //   Wenn:  Hostname equals "www.planegy.de"
  //   Dann:  Dynamic, URL: concat("https://planegy.de", http.request.uri.path)
  //          Status 301, "Preserve query string" an
  // Voraussetzung: DNS-Eintrag für www existiert und ist "Proxied" (orange Wolke).
  // Kanonische Adresse überall (Canonical, og:url, Sitemap, JSON-LD): https://planegy.de

  "observability": { "enabled": true }
}
